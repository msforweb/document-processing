DATABASE_URL=postgresql://document_user:document_password@localhost:5532/document_processing?schema=public
REDIS_URL=redis://localhost:6379
DOCUMENT_PROCESSING_CONCURRENCY=2
ESCALATION_EVALUATION_ENABLED=true
ESCALATION_EVALUATION_INTERVAL_MS=300000
JWT_SECRET=change-me-in-development
API_PORT=3001
WEB_PORT=5173
STORAGE_PATH=./storage
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
FIELD_REVIEW_CONFIDENCE=0.7

# Optional local OCR tools. Tesseract and Poppler (pdftoppm) are system packages.
TESSERACT_PATH=
TESSERACT_LANGUAGES=eng
TESSERACT_OEM=1
PDFTOPPM_PATH=
OCR_PDF_DPI=300
OCR_PDF_MAX_PAGES=10
OCR_PREPROCESSING_ENABLED=true
OCR_ADAPTIVE_THRESHOLD_ENABLED=true
OCR_IMAGE_PROCESSOR_PATH=

# Optional escalation email delivery via Resend
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
